  const y = task?.phase !== undefined && task?.phase !== null ? Number(task.phase) : NaN;
  if (Number.isFinite(y) && y > 1900) {
    return {
      startDate: `${y}-01-01`,
      endDate: `${y}-12-31`,
    };
  }
  return null;
};

