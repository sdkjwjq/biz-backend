import { ref, reactive, onMounted, onUnmounted, watch, computed, nextTick } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import { 
  Calendar, User, Plus, Search, Download, UploadFilled, View, Bell, Document, Warning
} from '@element-plus/icons-vue';
import { ElMessage } from 'element-plus';
import { getAllTasks, getTaskById, getForthTasks } from '@/api/task'; 
import { getAllUsers } from '@/api/user';
import { getAudit, getAuditByTaskId, getAuditLogs, reSubmitMaterial, auditTask, getTodoAudits } from '@/api/audit';
// 引入新的批量提交接口 batchSubmitMaterial
import { uploadFile, submitMaterial, batchSubmitMaterial, sendNotice } from '@/api/report';
import { getNotices } from '@/api/notice';
import { getDeptById } from '@/api/dept';

// --- 状态管理 ---
const route = useRoute();
const router = useRouter();

// 展开动画：记录“刚展开出现”的子行
